# Node.js Express Backend Service
FROM node:20-slim

WORKDIR /app

# Install build dependencies for canvas / tesseract if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .

EXPOSE 3001

CMD ["node", "server.js"]

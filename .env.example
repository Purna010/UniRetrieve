# UniRetrieve Server Environment Configuration
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/uniretrieve
JWT_SECRET=your_jwt_secret_key_here

# Notification & SMTP Services
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@domain.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Web Push VAPID Keys (Optional - dynamic fallback generated if empty)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Blockchain Ledger Configuration
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x99e7624603eE635e8c624663791f21416bA82B3A
PRIVATE_KEY=your_ethereum_private_key_here
